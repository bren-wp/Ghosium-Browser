# Ghosium Browser full-source Windows x64 release configuration.
#
# Keep upstream-only branded/proprietary integrations disabled. Technical GN
# argument names are upstream build API and are not public Ghosium branding.

is_debug = false
is_component_build = false
is_official_build = false
is_chrome_branded = false

target_cpu = "x64"

# Ghosium exits with its last browser window instead of keeping the application
# resident for legacy background-app mode. This reduces idle processes and
# improves shutdown without weakening renderer isolation, sandboxing or TLS.
enable_background_mode = false

# Keep useful native crash symbols while avoiding the very large Blink/V8 debug
# symbol payload in release builders.
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0

# Controlled external Windows builders compile locally; remote execution is not
# part of the Ghosium release trust boundary.
use_remoteexec = false
